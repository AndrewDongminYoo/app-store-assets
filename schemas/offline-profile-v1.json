{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "project",
    "mode",
    "runtime",
    "targets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "type": {
      "const": "offline-profile"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "fixture",
        "live"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "url",
        "commit",
        "files"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/target"
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store",
        "platform",
        "account",
        "app_id",
        "flavor",
        "stage",
        "inputs"
      ],
      "anyOf": [
        {
          "required": [
            "version"
          ]
        },
        {
          "required": [
            "version_source"
          ]
        }
      ],
      "properties": {
        "store": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "type": "string",
          "minLength": 1
        },
        "account_id": {
          "type": "string",
          "minLength": 1
        },
        "app_id": {
          "type": "string",
          "minLength": 1
        },
        "flavor": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "string",
          "minLength": 1
        },
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "track": {
          "type": "string",
          "minLength": 1
        },
        "release_status": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "object"
        },
        "version_source": {
          "type": "object"
        },
        "artifact": {
          "type": "object"
        },
        "replacement": {
          "type": "object"
        },
        "changelogs": {
          "type": "object"
        },
        "assets": {
          "type": "object"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
